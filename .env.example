# Database Configuration (PostgreSQL + Drizzle ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/promptwars"

# Google Gemini API Keys (High-Availability Key Rotation Pool)
# Comma-separated list of Gemini API keys for seamless rotation across 403/429/503 errors
GENERAL_GEMINI_API_KEYS="AIzaSy...,AIzaSy..."

# Primary / Fallback Single Gemini Key (Optional if GENERAL_GEMINI_API_KEYS is provided)
GEMINI_API_KEY=""

# Application Port & Host
PORT=3000
NODE_ENV="development"